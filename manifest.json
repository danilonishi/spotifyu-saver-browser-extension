{
  "manifest_version": 3,
  "name": "Send to Spotify Saver",
  "version": "0.1.0",
  "description": "Prefill Spotify Saver with a supported Spotify or YouTube link.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Send to Spotify Saver",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
